NEXT_PUBLIC_NEON_AUTH_URL=https://your-branch.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEXT_PUBLIC_MEMBER_PREVIEW=false

# Application-owned Neon Postgres data and first-admin bootstrap. Use immutable
# Neon Auth user IDs (comma separated), never email addresses, for bootstrap.
DATABASE_URL=
OSAI_BOOTSTRAP_ADMIN_USER_IDS=
OSAI_APP_URL=https://osai-pink.vercel.app

# Transactional administrator notifications (Resend, server-only).
RESEND_API_KEY=
OSAI_NOTIFICATION_FROM_EMAIL=

# OSai sends validated posts to ONN from the server only. The endpoint must
# accept the neutral ONN content contract and return the standard data envelope.
ONN_PUBLISHING_API_URL=http://localhost:3001/api/v1/content/submissions
ONN_PUBLISHING_API_TOKEN=

# DocuSign developer account (demo/sandbox). Keep all values server-only.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
DOCUSIGN_GENERAL_NDA_TEMPLATE_ID=
DOCUSIGN_SIGNER_ROLE=Signer
DOCUSIGN_STATE_SECRET=
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_API_BASE_URL=https://demo.docusign.net/restapi
